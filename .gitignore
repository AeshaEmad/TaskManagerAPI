## .NET / C# gitignore

# Build outputs
bin/
obj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docview

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# ─── SECURITY: Never commit secrets ───────────────────────────────────────────
# appsettings.json stays LOCAL ONLY — copy from appsettings.Example.json and fill in real values.
# appsettings.Example.json is the safe template committed to the repo.
appsettings.json
appsettings.Development.json
