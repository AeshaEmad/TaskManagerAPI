## .NET / C# gitignore

# Build outputs
bin/
obj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docview

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# ─── SECURITY: Never commit secrets ───────────────────────────────────────────
# appsettings.json contains connection strings & JWT secret
# Use appsettings.Example.json as a template instead
appsettings.Development.json

